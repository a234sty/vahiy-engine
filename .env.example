VAHIY_APP_NAME="Vahiy Engine"
VAHIY_APP_VERSION="1.0.0"
VAHIY_ENVIRONMENT="development"
VAHIY_AHIT_CORPUS_PATH="data/corpus/ahit/bible"

# Gemini is the default provider and only needs GEMINI_API_KEY.
# Set OPENAI_API_KEY as well to switch to OpenAI instead (it takes priority
# over Gemini when both are set). Neither is required for /health, /verse, or
# /search — only /chat needs a provider configured.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=
