VAHIY_APP_NAME="Vahiy Engine"
VAHIY_APP_VERSION="1.0.0"
VAHIY_ENVIRONMENT="development"
VAHIY_AHIT_CORPUS_PATH="data/corpus/ahit/bible"
# Local checkout of https://github.com/a234sty/ahit-corpus. Unprefixed (no
# VAHIY_) so it matches scripts/setup_corpus.sh, which clones the corpus to
# this same default path — run that script and this needs no configuration
# at all. If the directory isn't present, only the bundled KJV sample data
# is available (no error). Override to point at an existing checkout
# elsewhere (e.g. a mounted volume in production).
AHIT_CORPUS_ROOT="external/ahit-corpus"

# Gemini is the default provider and only needs GEMINI_API_KEY.
# Set OPENAI_API_KEY as well to switch to OpenAI instead (it takes priority
# over Gemini when both are set). Neither is required for /health, /verse, or
# /search — only /chat needs a provider configured.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=
